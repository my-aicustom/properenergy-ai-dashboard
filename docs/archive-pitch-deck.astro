---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Proper Energy — AI Solar PV Intelligence Platform (PLTS Tumbuh)</title>
  <meta name="description" content="Dashboard AI Generasi Baru untuk PLTS Residensial & Fleet Inverter Multi-Merek. Konsep PLTS Tumbuh by Proper Energy Indonesia." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .font-mono {
      font-family: 'JetBrains Mono', monospace;
    }
    @keyframes pulse-slow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.02); }
    }
    .animate-pulse-slow {
      animation: pulse-slow 3s infinite ease-in-out;
    }
    @keyframes flow {
      from { stroke-dashoffset: 40; }
      to { stroke-dashoffset: 0; }
    }
    .flow-line {
      stroke-dasharray: 6 6;
      animation: flow 1.2s linear infinite;
    }
  </style>
</head>
<body class="bg-[#F8FAFC] text-slate-900 min-h-screen antialiased flex flex-col">

  <!-- TOP ANNOUNCEMENT BANNER -->
  <aside aria-label="Demo notice" class="bg-gradient-to-r from-emerald-950 via-teal-900 to-slate-900 text-white text-xs px-4 py-2 border-b border-emerald-800/40">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
          PROPER ENERGY AI v2.4
        </span>
        <span class="text-slate-300">Demo Eksekutif Sistem Operasi AI untuk <strong>PLTS Tumbuh</strong> & Fleet Multi-Merek</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-emerald-400 font-mono">Bintaro Station: ONLINE</span>
        </span>
        <span class="hidden sm:inline font-mono">properenergy.id</span>
      </div>
    </div>
  </aside>

  <!-- NAVIGATION HEADER -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center shadow-lg shadow-teal-500/20 text-white font-black text-xl tracking-tighter">
          P<span class="text-amber-300">E</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-lg text-slate-900 tracking-tight">Proper Energy</span>
            <span class="text-[10px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-300/50">AI Core</span>
          </div>
          <p class="text-xs text-slate-500">Autonomous Solar Telemetry & Predictive O&M</p>
        </div>
      </div>

      <!-- Inverter Multi-Brand Switcher (Core Feature 4) -->
      <div class="hidden lg:flex items-center gap-2 bg-slate-100/80 p-1.5 rounded-xl border border-slate-200">
        <span class="text-xs font-semibold text-slate-700 px-2">Unit Inverter:</span>
        <select id="inverter-select" aria-label="Pilih Unit Inverter" class="bg-white text-xs font-semibold text-slate-800 py-1.5 px-3 rounded-lg border border-slate-300 shadow-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
          <option value="huawei">Huawei SUN2000-10KTL (Rumah Bintaro Sector 9)</option>
          <option value="sungrow">Sungrow SG10RS (Cluster Kebayoran Residences)</option>
          <option value="goodwe">GoodWe EH-6000 (Pondok Indah Estate)</option>
          <option value="growatt">Growatt SPH-6000 (BSD Green Cove)</option>
          <option value="sma">SMA Sunny Boy 5.0 (Alam Sutera Signature)</option>
          <option value="solis">Solis S6-EH1P (Bintaro Jaya Sektor 7)</option>
        </select>
        <span id="inverter-status-badge" class="inline-flex items-center px-2 py-1 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800">
          OPTIMAL
        </span>
      </div>

      <!-- Time of Day Simulator & Demo Portal Switcher -->
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex bg-slate-100 p-1 rounded-xl items-center gap-1 border border-slate-200">
          <button type="button" class="sim-btn px-2.5 py-1 text-xs font-semibold rounded-lg transition-all bg-white text-slate-900 shadow-sm" data-time="siang">
            ☀️ Siang
          </button>
          <button type="button" class="sim-btn px-2.5 py-1 text-xs font-semibold rounded-lg transition-all text-slate-600 hover:text-slate-900" data-time="pagi">
            🌅 Pagi
          </button>
          <button type="button" class="sim-btn px-2.5 py-1 text-xs font-semibold rounded-lg transition-all text-slate-600 hover:text-slate-900" data-time="sore">
            🌇 Sore
          </button>
          <button type="button" class="sim-btn px-2.5 py-1 text-xs font-semibold rounded-lg transition-all text-slate-600 hover:text-slate-900" data-time="malam">
            🌙 Malam
          </button>
        </div>

        <a href="/demo" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-700 text-white font-bold text-xs shadow-md shadow-emerald-500/20 hover:from-emerald-500 hover:to-teal-600 transition-all border border-emerald-500/30">
          <span>🖥️ Dashboard Demo Operasional</span>
          <span>➔</span>
        </a>
      </div>

    </div>
  </header>

  <!-- MAIN DASHBOARD CONTENT -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- HERO VALUE PROPOSITION: SOFTWARE BAWAAN VS PROPER AI -->
    <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-teal-950 text-white rounded-3xl p-6 lg:p-8 shadow-xl relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute right-40 -top-20 w-60 h-60 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 text-xs font-semibold border border-teal-500/30 mb-3">
            <span>⚡ Standard Inverter vs Proper Energy AI</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white">
            Bukan Sekadar Grafik Listrik,<br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-emerald-400 to-amber-300">
              Ini Otak AI yang Menjaga Investasi PLTS Anda.
            </span>
          </h1>
          <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
            Software bawaan inverter cuma menampilkan data pasif. <strong>Proper Energy AI</strong> secara aktif memprediksi radiasi, mendeteksi anomali debu/bayangan, menyatukan inverter lintas merek, dan menghitung penghematan riil dalam Rupiah.
          </p>
        </div>

        <!-- Quick Live Telemetry Pill Box -->
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/10 flex flex-col gap-2 min-w-[260px]">
          <div class="text-[11px] font-bold text-teal-300 uppercase tracking-wider flex items-center justify-between">
            <span>Stasiun Cuaca Bintaro</span>
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          </div>
          <div class="flex items-center justify-between pt-1">
            <span class="text-xs text-slate-300">Radiasi Matahari</span>
            <span id="tele-irradiance" class="font-mono font-bold text-amber-300 text-sm">842 W/m²</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300">Suhu Panel Sel Surya</span>
            <span id="tele-temp" class="font-mono font-bold text-white text-sm">48.2 °C</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-300">Performance Ratio (PR)</span>
            <span id="tele-pr" class="font-mono font-bold text-emerald-300 text-sm">84.6% (Ideal)</span>
          </div>
          <div class="mt-2 pt-2 border-t border-white/10 text-[11px] text-slate-300 flex items-center justify-between">
            <span>Status PLN Grid</span>
            <span class="text-emerald-300 font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Sinkron Normal (228V)
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 5 BENTO KPI CARDS -->
    <section aria-label="Key Performance Indicators" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Card 1: Real-time Power -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold">Daya Real-Time</span>
          <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm">⚡</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="kpi-power" class="text-3xl font-extrabold text-slate-900 tracking-tight">14.8</span>
          <span class="text-sm font-bold text-slate-500">kW</span>
        </div>
        <div class="mt-2 flex items-center gap-1.5 text-xs text-emerald-800 font-bold">
          <span>▲ 94.2%</span>
          <span class="text-slate-600 font-medium">dari kurva ideal jam ini</span>
        </div>
      </div>

      <!-- Card 2: Today's Yield vs AI Forecast -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold">Produksi Hari Ini</span>
          <span class="w-7 h-7 rounded-lg bg-teal-50 text-teal-800 flex items-center justify-center font-bold text-sm">📊</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="kpi-energy" class="text-3xl font-extrabold text-slate-900 tracking-tight">68.4</span>
          <span class="text-sm font-bold text-slate-500">kWh</span>
        </div>
        <div class="mt-2 flex items-center gap-1 text-xs text-slate-500">
          <span>Target Prediksi AI:</span>
          <span id="kpi-forecast" class="font-semibold text-slate-700">72.1 kWh</span>
        </div>
      </div>

      <!-- Card 3: PLTS Tumbuh Battery Storage (Phase 2 Safer) -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <div class="flex items-center gap-1">
            <span class="text-xs font-semibold">Baterai (PLTS Tumbuh)</span>
            <span class="text-[9px] font-bold px-1 py-0.5 rounded bg-emerald-100 text-emerald-800">Safer</span>
          </div>
          <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">🔋</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span id="kpi-battery" class="text-3xl font-extrabold text-slate-900 tracking-tight">88%</span>
          <span class="text-xs font-medium text-slate-500">(15.2 kWh)</span>
        </div>
        <div class="mt-2 flex items-center gap-1 text-xs text-emerald-800 font-bold">
          <span>🛡️ Backup Siap:</span>
          <span id="kpi-backup-hours" class="font-mono text-slate-700 font-bold">8.4 Jam</span>
        </div>
      </div>

      <!-- Card 4: Rupiah Savings -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold">Hemat Listrik Bulan Ini</span>
          <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-sm">💰</span>
        </div>
        <div class="flex items-baseline gap-1">
          <span class="text-xs font-bold text-slate-600">Rp</span>
          <span id="kpi-savings" class="text-2xl font-extrabold text-emerald-700 tracking-tight">2.840.000</span>
        </div>
        <div class="mt-2 text-xs text-slate-500">
          Proyeksi Akhir Bulan: <strong class="text-slate-800">Rp 3.650.000</strong>
        </div>
      </div>

      <!-- Card 5: Carbon Offset ESG -->
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between text-slate-500 mb-2">
          <span class="text-xs font-semibold">Reduksi Karbon (ESG)</span>
          <span class="w-7 h-7 rounded-lg bg-teal-50 text-teal-700 flex items-center justify-center font-bold text-sm">🌱</span>
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-3xl font-extrabold text-slate-900 tracking-tight">56.2</span>
          <span class="text-sm font-bold text-slate-500">kg CO₂</span>
        </div>
        <div class="mt-2 text-xs text-slate-500">
          Setara menanam <strong>2.8 pohon</strong> hari ini
        </div>
      </div>

    </section>

    <!-- INTERACTIVE ENERGY FLOW DIAGRAM (SOLAR -> INVERTER -> BATTERY -> HOME -> GRID) -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Aliran Daya Real-Time (Energy Flow Engine)</h2>
          <p class="text-xs text-slate-500">Visualisasi dinamis pembagian daya surya, penyimpanan baterai, dan konsumsi beban rumah</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Mode: Self-Consumption Optimal (94% Solar Covered)
          </span>
        </div>
      </div>

      <!-- Energy Flow Node Grid -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4 items-center justify-center py-4">
        
        <!-- Node 1: Solar Panels -->
        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 text-center relative flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-2xl mb-2 shadow-inner">
            ☀️
          </div>
          <span class="text-xs font-bold text-slate-500 uppercase">Panel Surya Atap</span>
          <span id="flow-solar" class="text-xl font-extrabold text-slate-900 mt-1">14.8 kW</span>
          <span class="text-[11px] text-amber-700 font-medium mt-0.5">Produksi Maksimal</span>
        </div>

        <!-- Flow 1 to Inverter -->
        <div class="hidden md:flex flex-col items-center justify-center text-slate-400">
          <span class="text-[11px] font-mono text-emerald-800 font-bold mb-1">DC Power ➔</span>
          <div class="w-full h-1 bg-gradient-to-r from-amber-400 to-teal-500 rounded-full"></div>
        </div>

        <!-- Node 2: Smart Hybrid Inverter -->
        <div class="bg-gradient-to-b from-teal-900 to-slate-900 text-white rounded-2xl p-5 border border-teal-700 text-center relative flex flex-col items-center shadow-lg">
          <div class="w-12 h-12 rounded-2xl bg-teal-800 text-teal-200 flex items-center justify-center text-2xl mb-2">
            ⚡
          </div>
          <span class="text-xs font-bold text-teal-300 uppercase">Hybrid Inverter</span>
          <span id="flow-inverter-brand" class="text-sm font-extrabold text-white mt-1">Huawei SUN2000</span>
          <div class="mt-2 text-[10px] font-mono bg-teal-950/80 px-2 py-0.5 rounded text-teal-300">
            Efisiensi Inverter: 98.4%
          </div>
        </div>

        <!-- Flow 2 to Battery & Home -->
        <div class="hidden md:flex flex-col items-center justify-center text-slate-400">
          <span class="text-[11px] font-mono text-emerald-800 font-bold mb-1">AC Clean Power ➔</span>
          <div class="w-full h-1 bg-gradient-to-r from-teal-500 to-emerald-500 rounded-full"></div>
        </div>

        <!-- Node 3: Home Consumption & Battery -->
        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 text-center relative flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl mb-2 shadow-inner">
            🏠
          </div>
          <span class="text-xs font-bold text-slate-500 uppercase">Beban Rumah (Load)</span>
          <span id="flow-load" class="text-xl font-extrabold text-slate-900 mt-1">4.2 kW</span>
          <span class="text-[11px] text-emerald-700 font-semibold mt-0.5">100% Ditutup Surya</span>
        </div>

      </div>

      <!-- Sub-flow summary -->
      <div class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-600">
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60 flex items-center justify-between">
          <span>Surplus Daya ke Baterai:</span>
          <strong id="flow-to-bat" class="font-mono text-emerald-700 font-bold">+8.5 kW (Charging)</strong>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60 flex items-center justify-between">
          <span>Ekspor Daya ke Beban Rumah:</span>
          <strong class="font-mono text-slate-900 font-bold">4.2 kW (Aktif)</strong>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/60 flex items-center justify-between">
          <span>Impor Daya dari PLN:</span>
          <strong class="font-mono text-emerald-800 font-bold">0.0 kW (Hemat 100%)</strong>
        </div>
      </div>
    </div>

    <!-- 6 AI PILLARS COMPARISON (THE CORE CLIENT REQUIREMENT TABLE) -->
    <div class="bg-white rounded-3xl p-6 lg:p-8 border border-slate-200/80 shadow-sm">
      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold mb-2">
          <span>MATRIKS KEUNGGULAN KOMPETITIF</span>
        </div>
        <h2 class="text-2xl lg:text-3xl font-extrabold text-slate-900 tracking-tight">
          6 Pilar AI Proper Energy vs Software Bawaan Inverter
        </h2>
        <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">
          Inilah pembeda fundamental kenapa klien korporat dan pemilik residensial premium beralih ke Proper Energy. Kami mengubah sekadar rekaman pasif menjadi sistem kecerdasan proaktif.
        </p>
      </div>

      <!-- 6 Cards Grid representing the image table -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        
        <!-- Pillar 1: Analisis Produksi Optimal -->
        <div class="rounded-2xl p-5 border border-slate-200 bg-gradient-to-b from-white to-slate-50/50 hover:border-teal-400 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-800">Pilar 01</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-100 text-teal-800">Efficiency AI</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Analisis Produksi Optimal</h3>
            
            <div class="my-3 p-3 rounded-xl bg-red-50/70 border border-red-100 text-xs">
              <span class="font-bold text-red-800">Software Bawaan:</span>
              <p class="text-red-700/90 mt-0.5">Cuma monitor angka produksi listrik tanpa tahu apakah performanya di bawah potensi seharusnya.</p>
            </div>

            <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-200/60 text-xs">
              <span class="font-bold text-emerald-900">Solusi AI Proper Energy:</span>
              <p class="text-emerald-800 mt-0.5">Menganalisis radiasi matahari lokal vs output riil. Mendeteksi jika terjadi <em>Yield Gap</em> (penurunan efisiensi >5%).</p>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200/60 flex items-center justify-between text-xs text-slate-500">
            <span>Diagnosa Hari Ini:</span>
            <span class="font-semibold text-emerald-600 font-mono">Efisiensi 98.2% (Optimal)</span>
          </div>
        </div>

        <!-- Pillar 2: Prediksi Produksi & Penghematan -->
        <div class="rounded-2xl p-5 border border-slate-200 bg-gradient-to-b from-white to-slate-50/50 hover:border-teal-400 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wider text-teal-800">Pilar 02</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Predictive ML</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Prediksi Produksi & Hemat</h3>
            
            <div class="my-3 p-3 rounded-xl bg-red-50/70 border border-red-100 text-xs">
              <span class="font-bold text-red-800">Software Bawaan:</span>
              <p class="text-red-700/90 mt-0.5">Cuma menampilkan grafik energi masa lalu (historis kaku tanpa insight masa depan).</p>
            </div>

            <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-200/60 text-xs">
              <span class="font-bold text-emerald-900">Solusi AI Proper Energy:</span>
